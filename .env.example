# Copie ce fichier en `.env` (même dossier) et remplis les valeurs.
# Le fichier `.env` est ignoré par git : ne le publie jamais.

# ElevenLabs (génération des voix) — nouvelle clé, avec plafond de dépense
ELEVEN_API_KEY=

# Cloudflare R2 (envoi des MP3) — jeton limité au bucket pocketsage-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google Cloud Text-to-Speech — clé restreinte à l'API Text-to-Speech
GOOGLE_TTS_API_KEY=
