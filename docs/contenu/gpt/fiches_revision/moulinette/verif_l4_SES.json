  {
   "id": "REV-SES-TLE-41",
   "action": "corriger",
   "corrections": {
    "quiz": [
     {
      "q": "Que mesure la tertiarisation ?",
      "choix": [
       "La disparition de tous les salariés",
       "La baisse obligatoire du niveau de formation",
       "La progression de la part des services dans l’emploi"
      ],
      "rep": "La progression de la part des services dans l’emploi",
      "expl": "Elle concerne la place du secteur tertiaire."
     },
     {
      "q": "De 50 à 70 emplois de services sur 100, quelle est la hausse de part ?",
      "choix": [
       "20 points de pourcentage",
       "2 points de pourcentage",
       "70 points de pourcentage"
      ],
      "rep": "20 points de pourcentage",
      "expl": "La différence entre 70 % et 50 % est de 20 points."
     },
     {
      "q": "Que signifie salarisation ?",
      "choix": [
       "La disparition de tout travail indépendant",
       "Une hausse de la part des salariés dans l’emploi",
       "Une hausse automatique de tous les salaires"
      ],
      "rep": "Une hausse de la part des salariés dans l’emploi",
      "expl": "Le terme concerne la place du statut salarié."
     }
    ]
   },
   "note": "Distracteur « 20 % des emplois initiaux » ambigu (20 emplois = 20 % des 100 emplois) : remplacé."
  },
