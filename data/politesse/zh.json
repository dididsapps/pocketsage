   ],
   "icon": "👋",
   "h": "ac7fe54d",
   "titre": "打招呼",
   "texte": "到达某个地方时，请面带微笑地问好；离开时，也请说再见！"
  },
  {
   "id": "POL-M-002",
   "tab": "manieres",
   "a": [
    1,
    2
   ],
   "icon": "✨",
   "h": "e684a40f",
   "titre": "魔法咒语",
   "texte": "“请”和“谢谢”是神奇的词语：它们能打开所有大门。"
  },
  {
   "id": "POL-M-003",
   "tab": "manieres",
   "a": [
    1
   ],
   "icon": "🧸",
   "h": "bf40431f",
   "titre": "分享",
   "texte": "轮流玩玩具。一起玩更有乐趣！"
  },
  {
   "id": "POL-M-004",
   "tab": "manieres",
   "a": [
    1,
    2
   ],
   "icon": "⏳",
   "h": "284ef583",
   "titre": "等待轮到你",
   "texte": "排队或玩游戏时，每个人都要轮流行动。耐心等待是对他人的尊重。"
  },
  {
   "id": "POL-M-005",
   "tab": "manieres",
   "a": [
    1
   ],
   "icon": "🧼",
   "h": "e949da31",
   "titre": "洗手",
   "texte": "饭前便后要用肥皂彻底洗手。"
  },
  {
   "id": "POL-M-006",
   "tab": "manieres",
   "a": [
    1,
    2
   ],
   "icon": "🧺",
   "h": "08116477",
   "titre": "游骑兵",
   "texte": "玩完后请把东西收好。你的家人会感谢你的！"
  },
  {
   "id": "POL-M-007",
   "tab": "manieres",
   "a": [
    1,
    2
   ],
   "icon": "🤧",
   "h": "8bc714ea",
   "titre": "咳嗽时用手肘遮挡",
   "texte": "咳嗽或打喷嚏时，用手肘挡住嘴巴。"
  },
  {
   "id": "POL-M-008",
   "tab": "manieres",
   "a": [
    1,
    2,
    3
   ],
   "icon": "🍽️",
   "h": "e8f215d7",
   "titre": "在餐桌旁",
   "texte": "等所有人都吃完饭后再开始。一定要说“请”和“谢谢”。"
  },
  {
   "id": "POL-M-009",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "🙂",
   "h": "7d86eb86",
   "titre": "迎接",
   "texte": "打招呼时要看着对方的眼睛。真诚的微笑胜过千言万语。"
  },
  {
   "id": "POL-M-010",
   "tab": "manieres",
   "a": [
    1,
    2,
    3
   ],
   "icon": "👂",
   "h": "61b43fc7",
   "titre": "听",
   "texte": "别人说话时不要打断。认真倾听是一种馈赠。"
  },
  {
   "id": "POL-M-011",
   "tab": "manieres",
   "a": [
    1,
    2,
    3
   ],
   "icon": "🙏",
   "h": "8531e6a3",
   "titre": "感谢",
   "texte": "真诚而发自内心的感谢能建立牢固的关系。不要等着别人提醒你。"
  },
  {
   "id": "POL-M-012",
   "tab": "manieres",
   "a": [
    1,
    2,
    3
   ],
   "icon": "💬",
   "h": "eff1d8ba",
   "titre": "道歉",
   "texte": "道歉需要勇气。一句发自内心的“对不起”能抚慰很多伤痛。"
  },
  {
   "id": "POL-M-013",
   "tab": "manieres",
   "a": [
    2
   ],
   "icon": "🚪",
   "h": "40a90abf",
   "titre": "进入前请敲门",
   "texte": "进入房间或办公室前，请先敲门并等待回应。"
  },
  {
   "id": "POL-M-014",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "🤝",
   "h": "adaf44fb",
   "titre": "扶住门",
   "texte": "为身后的人扶住门。一个小小的举动，却总能让人感到温暖。"
  },
  {
   "id": "POL-M-015",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "🚌",
   "h": "126e3f43",
   "titre": "让路",
   "texte": "在公交车上，请把座位让给老人、孕妇或站立困难的人。"
  },
  {
   "id": "POL-M-016",
   "tab": "manieres",
   "a": [
    2
   ],
   "icon": "🫶",
   "h": "ffcbb151",
   "titre": "包括其他人",
   "texte": "如果有人课间休息时独自一人玩耍，就主动提出陪他们玩。"
  },
  {
   "id": "POL-M-017",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "🗣️",
   "h": "17e3aab0",
   "titre": "冷静地说",
   "texte": "无需大声喊叫才能被听到：平静的声音更容易被倾听。"
  },
  {
   "id": "POL-M-018",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "📵",
   "h": "b0448133",
   "titre": "电话",
   "texte": "吃饭和交谈时请把手机收起来。你的陪伴就是你最大的礼物。"
  },
  {
   "id": "POL-M-019",
   "tab": "manieres",
   "a": [
    3
   ],
   "icon": "📱",
   "h": "372529bf",
   "titre": "信息和网络",
   "texte": "在发布或发送消息之前，问问自己：我会当面跟别人说这些话吗？"
  },
  {
   "id": "POL-M-020",
   "tab": "manieres",
   "a": [
    3
   ],
   "icon": "⏰",
   "h": "757b30db",
   "titre": "准时到达",
   "texte": "准时到达表明你尊重他人的时间。如果你会迟到，请提前告知。"
  },
  {
   "id": "POL-M-021",
   "tab": "manieres",
   "a": [
    3
   ],
   "icon": "🤝",
   "h": "25ccaee9",
   "titre": "自我介绍",
   "texte": "自我介绍时，看着对方，清晰地说出你的名字，并微笑。"
  },
  {
   "id": "POL-M-022",
   "tab": "manieres",
   "a": [
    3
   ],
   "icon": "⚖️",
   "h": "4a5748c4",
   "titre": "尊重他人意见",
   "texte": "你可以不同意别人的观点，但不必令人不快：批评观点，但不要批评人。"
  },
  {
   "id": "POL-M-023",
   "tab": "manieres",
   "a": [
    1,
    2
   ],
   "icon": "🤗",
   "h": "fbfdb7e8",
   "titre": "交朋友",
   "texte": "走近些，报上你的名字，然后问：“你想和我一起玩吗？” 很多美好的友谊就是这样开始的。"
  },
  {
   "id": "POL-M-024",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "🌟",
   "h": "5db0abbf",
   "titre": "给予赞美",
   "texte": "真诚而具体地赞美他人：“我喜欢你的画，颜色太棒了！”这样的赞美总是受欢迎的。"
  },
  {
   "id": "POL-M-025",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "👂",
   "h": "9ae48e2b",
   "titre": "听听朋友的建议",
   "texte": "当朋友和你说话时，看着他们，把屏幕放到一边，问问他们说的话是什么意思。"
  },
  {
   "id": "POL-M-026",
   "tab": "manieres",
   "a": [
    1,
    2,
    3
   ],
   "icon": "🎁",
   "h": "98b53493",
   "titre": "小举动",
   "texte": "一幅画、一句温暖的话语、一份自制的小礼物：小小的举动让友谊长存。"
  },
  {
   "id": "POL-M-027",
   "tab": "manieres",
   "a": [
    2,
    3
   ],
   "icon": "🤫",
   "h": "e191755b",
   "titre": "保守秘密",
   "texte": "如果朋友向你吐露秘密，一定要保守秘密。除非有人身处险境：在这种情况下，你必须告诉一位值得信赖的成年人。"
  },
  {
   "id": "POL-M-028",
   "tab": "manieres",
   "a": [
    3
   ],
   "icon": "📇",
   "h": "4048df9f",
   "titre": "记住名字",
   "texte": "记住并称呼对方的名字，能让他们感受到你的重视。"
  },
  {
   "id": "POL-M-029",
   "tab": "manieres",
   "a": [
    3
   ],
   "icon": "🌷",
   "h": "e9b7e44e",
   "titre": "收到赞美",
   "texte": "当有人称赞你时，一句简单的“谢谢”就足够了，无需解释。"
  },
  {
   "id": "POL-D-001",
   "tab": "dictons",
   "a": [
    1,
    2
   ],
   "icon": "🐦",
   "h": "f5b9532d",
   "texte": "鸟儿一点一点地筑巢。——法国谚语"
  },
  {
   "id": "POL-D-002",
   "tab": "dictons",
   "a": [
    1,
    2
   ],
   "icon": "😊",
   "h": "d37ef851",
   "texte": "微笑无需花费任何成本，却能带来很多。——谚语"
  },
  {
   "id": "POL-D-003",
   "tab": "dictons",
   "a": [
    1,
    2,
    3
   ],
   "icon": "💛",
   "h": "1b657cc9",
   "texte": "己所不欲，勿施于人。——黄金法则，存在于许多文化中。"
  },
  {
   "id": "POL-D-004",
   "tab": "dictons",
   "a": [
    1,
    2
   ],
   "icon": "🐭",
   "h": "6a41a0c4",
   "texte": "我们常常需要比我们更渺小的人。——让·德·拉封丹"
  },
  {
   "id": "POL-D-005",
   "tab": "dictons",
   "a": [
    1,
    2
   ],
   "icon": "🐢",
   "h": "332623f2",
   "texte": "不必着急，你必须准时出发。——让·德·拉封丹"
  },
  {
   "id": "POL-D-006",
   "tab": "dictons",
   "a": [
    1,
    2
   ],
   "icon": "🤝",
   "h": "bec81e9c",
   "texte": "团结就是力量。——比利时格言"
  },
  {
   "id": "POL-D-007",
   "tab": "dictons",
   "a": [
    1,
    2
   ],
   "icon": "⏰",
   "h": "561f1e5b",
   "texte": "亡羊补牢，为时未晚。——谚语"
  },
  {
   "id": "POL-D-008",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🔨",
   "h": "ef353dfa",
   "texte": "熟能生巧。——法国谚语"
  },
  {
   "id": "POL-D-009",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "💧",
   "h": "d4dfd6b5",
   "texte": "小溪汇成大河。——法国谚语"
  },
  {
   "id": "POL-D-010",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "⏳",
   "h": "8dbbb8df",
   "texte": "耐心和时间比力量或愤怒更有用。——让·德·拉封丹"
  },
  {
   "id": "POL-D-011",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🧑‍🔧",
   "h": "d8e759fd",
   "texte": "没有糟糕的工作。——谚语"
  },
  {
   "id": "POL-D-012",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🐌",
   "h": "c0439c9c",
   "texte": "无论你走得多快，重要的是不要停下来。——孔子语录"
  },
  {
   "id": "POL-D-013",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "✍️",
   "h": "0168a01b",
   "texte": "构思清晰的事物，表达自然清晰。——尼古拉斯·布瓦洛"
  },
  {
   "id": "POL-D-014",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🦊",
   "h": "b659c8bc",
   "texte": "只有用心才能看得清楚。真正重要的东西，眼睛是看不见的。——安托万·德·圣埃克苏佩里，《小王子》"
  },
  {
   "id": "POL-D-015",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🌱",
   "h": "b3d2e252",
   "texte": "亡羊补牢，为时未晚。——谚语"
  },
  {
   "id": "POL-D-016",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🚲",
   "h": "8b45a39a",
   "texte": "人生就像骑自行车：为了保持平衡，你必须不断前进。——阿尔伯特·爱因斯坦"
  },
  {
   "id": "POL-D-017",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "✨",
   "h": "f7c42bb0",
   "texte": "礼貌是一种在众多想法中进行选择的艺术。—— （据传为斯塔尔夫人所言）"
  },
  {
   "id": "POL-D-018",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🌸",
   "h": "3e64a566",
   "texte": "礼貌之于心灵，犹如优雅之于容貌。——伏尔泰"
  },
  {
   "id": "POL-D-019",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🎯",
   "h": "88549e42",
   "texte": "成功的秘诀在于目标的持之以恒。——本杰明·迪斯雷利"
  },
  {
   "id": "POL-D-020",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🎨",
   "h": "b065050a",
   "texte": "伟大的成就并非一时冲动，而是由一系列小事累积而成。——文森特·梵高"
  },
  {
   "id": "POL-D-021",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🙏",
   "h": "eeb47b63",
   "texte": "感恩之心让我们觉得拥有的一切足够。——美国作家梅洛迪·比蒂"
  },
  {
   "id": "POL-D-022",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🌻",
   "h": "98d9b2a1",
   "texte": "我们必须耕耘自己的花园。——伏尔泰，《老实人》"
  },
  {
   "id": "POL-D-023",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🐎",
   "h": "aece8da5",
   "texte": "想远行的人，会善待自己的马。——让·拉辛"
  },
  {
   "id": "POL-D-024",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🔥",
   "h": "f3bbba9b",
   "texte": "没有激情，世上就不可能成就任何伟大的事情。——黑格尔"
  },
  {
   "id": "POL-D-025",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "📚",
   "h": "f4700178",
   "texte": "教育是你可以用来改变世界的最强大的武器。——纳尔逊·曼德拉"
  },
  {
   "id": "POL-D-026",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🚀",
   "h": "5dbc64d2",
   "texte": "未来属于那些能够想象它、设计它并使其实现的人。未来不是等待就能得到的，而是需要创造的。——谢赫·穆罕默德·本·拉希德·阿勒马克图姆，镌刻于迪拜未来博物馆"
  },
  {
   "id": "POL-D-027",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🏛️",
   "h": "2094e554",
   "texte": "未来不会等待：它今天就可以被想象、设计和建造。——迪拜未来博物馆，谢赫·穆罕默德·本·拉希德·阿勒马克图姆"
  },
  {
   "id": "POL-D-028",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🎓",
   "h": "0f7bdfd3",
   "texte": "一个国家的真正财富在于其人民，尤其是受过教育的人民。——阿联酋国父谢赫·扎耶德·本·苏丹·阿勒纳哈扬如是说。"
  },
  {
   "id": "POL-D-029",
   "tab": "dictons",
   "a": [
    1,
    2,
    3
   ],
   "icon": "🪞",
   "h": "94da8f67",
   "texte": "己所不欲，勿施于人。——孔子"
  },
  {
   "id": "POL-D-030",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "🌾",
   "h": "9161b7a3",
   "texte": "种瓜得瓜，种豆得豆。——谚语"
  },
  {
   "id": "POL-D-031",
   "tab": "dictons",
   "a": [
    1,
    2,
    3
   ],
   "icon": "🎁",
   "h": "de4a7a8d",
   "texte": "小礼物维系友谊。——法国谚语"
  },
  {
   "id": "POL-D-032",
   "tab": "dictons",
   "a": [
    2,
    3
   ],
   "icon": "👥",
   "h": "71e3d251",
   "texte": "告诉我你的朋友是谁，我就能告诉你你是怎样的人。——谚语"
  },
  {
   "id": "POL-D-033",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "🤝",
   "h": "32eea31a",
   "texte": "要想拥有朋友，唯一的办法就是先成为朋友。——拉尔夫·沃尔多·爱默生"
  },
  {
   "id": "POL-D-034",
   "tab": "dictons",
   "a": [
    3
   ],
   "icon": "💞",
   "h": "bab7ba49",
   "texte": "友谊使快乐加倍，悲伤减半。——弗朗西斯·培根"
  },
  {
   "id": "POL-C-001",
   "tab": "conseils",
   "a": [
    1
   ],
   "icon": "🔁",
   "h": "4a69f474",
   "titre": "再试一次",
   "texte": "如果觉得困难，就深呼吸，再试一次。每一次尝试都会让你变得更强大！"
  },
  {
   "id": "POL-C-002",
   "tab": "conseils",
   "a": [
    1,
    2
   ],
   "icon": "🙋",
